# CampusFlow Web 环境变量模板
# 复制为 .env 后按需填写；.env / .env.local 均已被 .gitignore 忽略。
#
# 只放「非敏感」配置：密码 / Token / 密钥一律不写进代码与本文件。

VITE_APP_TITLE=CampusFlow

# ── 后端地址（浏览器侧，F3 起启用）──
# 推荐**留空**：请求走相对路径 /api/*（如 /api/exams、/api/courses），
# 由 Vite 开发服务器反代到 Spring Boot。
# 原因：campus-service 只监听回环地址、且没有任何 CORS 配置，
# 浏览器直连会被拦（实测 net::ERR_FAILED，读不到响应体）。
# 同源代理是开发期唯一可行路径，详见 vite.config.ts 的 server.proxy
# 与 src/api/exams.ts 顶部「怎么绕开 CORS」的说明。
VITE_API_BASE_URL=

# 仅当需要绕开代理直连后端（例如预览 dist、或后端已配好 CORS）时才填写：
# VITE_API_BASE_URL=http://localhost:8080

# ── 代理目标（仅 Vite 开发服务器读取，不进入浏览器）──
# 默认 http://127.0.0.1:8080。后端换端口时用环境变量覆盖，不要改 vite.config.ts：
#   PowerShell:  $env:CAMPUS_API_TARGET='http://127.0.0.1:8091'; npm run dev
#   Git Bash:    CAMPUS_API_TARGET=http://127.0.0.1:8091 npm run dev
# CAMPUS_API_TARGET=http://127.0.0.1:8080

# ── Agent 服务代理目标（F4 起，仅 Vite 开发服务器读取）──
# `/api/agent/*` 前缀的请求反代到 Python Agent（FastAPI），其余 `/api/*` 仍走 Spring Boot。
# 默认 http://127.0.0.1:8000，与 campus-agent/app/api/server.py 的默认端口一致。
#   PowerShell:  $env:AGENT_API_TARGET='http://127.0.0.1:8001'; npm run dev
#   Git Bash:    AGENT_API_TARGET=http://127.0.0.1:8001 npm run dev
# AGENT_API_TARGET=http://127.0.0.1:8000

# ── Agent 服务自身监听的端口（只有 campus-agent 进程读取，前端不读）──
# 留空即用 app/api/server.py 的默认值 8000；改这里必须同步改 AGENT_API_TARGET，
# 否则代理指到一个没人监听的端口（表现为 502 / 连接被拒）。
#   $env:AGENT_PORT='8001'; python -m app.api.server
# AGENT_PORT=8000

# 本文件只登记「非敏感」配置：Agent 侧的 LLM Key / LangSmith Key 一律写在
# 仓库根目录的 .env（campus-agent 的配置层自己向上回溯定位），不进前端包也不进本文件。

# ── 前端开发阶段的临时固定测试学生（尚无登录体系，不做鉴权）──
# 后端 data.sql 已为 student-001 准备两场考试；student-002 用于验证数据确实不同。
# 接入真实登录态后，这里应改为从会话读取，而不是环境变量。
VITE_CAMPUS_STUDENT_ID=student-001
