{
  "version": 1,
  "description": "CampusFlow 检索评估数据集（人工维护的标准答案）。expected_sources 为空数组表示负样本：该问题本就不该命中知识库。来源路径相对 data/knowledge/ 目录。expected_min_score 为可选的相关性下限，用于分数标定回归检查（当前配置实测：正样本命中分数 ≥ 0.58，负样本最高 0.35，故 0.5 是安全下限）。",
  "cases": [
    {
      "case_id": "library-hours",
      "question": "图书馆开放时间是怎么规定的？",
      "expected_sources": ["campus_rules.md"],
      "expected_keywords": ["开放时间", "22:00"],
      "expected_min_score": 0.5
    },
    {
      "case_id": "book-limit",
      "question": "本科生一次最多能借多少本书，借期是多久？",
      "expected_sources": ["campus_rules.md"],
      "expected_keywords": ["借书上限", "续借"]
    },
    {
      "case_id": "scholarship-conditions",
      "question": "综合奖学金的评定条件是什么？",
      "expected_sources": ["campus_rules.md"],
      "expected_keywords": ["综合素质测评", "75"]
    },
    {
      "case_id": "makeup-vs-deferred",
