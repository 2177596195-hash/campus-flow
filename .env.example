# =============================================================================
# CampusFlow 配置模板（非敏感，可入库）
#
# 用法：复制为 .env 后填入真实密钥。
#     cd campus-agent && copy ..\.env.example ..\.env
#
# 约定：
#   * 本文件**只放占位符**，任何真实密钥都不得写进来（仓库内的 .env 已被
#     .gitignore 忽略）。占位符统一样式 <your-xxx-key>。
#   * 标注「默认」的值与 app/config/settings.py 里的默认值一致；标注「当前」
#     的是本项目当前正式运行的取值（与 .env 保持同步，便于新人一眼看到现状）。
#   * 配置在 get_*_settings() 处一次性校验：取值非法会抛 ConfigurationError
#     并以退出码 2 结束，不会带着半截配置继续跑。
# =============================================================================

# -----------------------------------------------------------------------------
# 应用
# -----------------------------------------------------------------------------
APP_NAME=CampusFlow
APP_ENV=development
LOG_LEVEL=INFO
# memory | sqlite（多轮会话的检查点后端）
#   memory：进程内，零依赖，但进程退出即丢失会话状态（默认）
#   sqlite：状态落本地文件，**进程重启后同一 --session-id 仍能续上**
CHECKPOINTER_BACKEND=memory
# 仅 sqlite 后端使用；留空则用 campus-agent/.storage/checkpoints/campus_flow.sqlite
# 相对路径按 campus-agent/ 解析；.storage/ 已被 .gitignore 忽略
# CHECKPOINTER_SQLITE_PATH=

# -----------------------------------------------------------------------------
# LLM（对话与意图识别）
# -----------------------------------------------------------------------------
# deepseek | qwen
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=<your-deepseek-api-key>
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 使用 qwen 时才需要
# DASHSCOPE_API_KEY=<your-dashscope-api-key>
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=60.0
LLM_MAX_RETRIES=2

# -----------------------------------------------------------------------------
# Embedding（RAG 向量化）
# -----------------------------------------------------------------------------
# qwen | openai
EMBEDDING_PROVIDER=qwen
DASHSCOPE_API_KEY=<your-dashscope-api-key>
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
# 留空表示使用模型默认维度
# EMBEDDING_DIMENSIONS=
EMBEDDING_BATCH_SIZE=10
EMBEDDING_TIMEOUT=30.0
EMBEDDING_MAX_RETRIES=2

# -----------------------------------------------------------------------------
# RAG（检索）
# -----------------------------------------------------------------------------
RAG_KNOWLEDGE_DIR=data/knowledge
RAG_PERSIST_DIR=.storage/vectorstore
RAG_COLLECTION=campus_knowledge
# chroma | milvus
VECTORSTORE_BACKEND=chroma
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=4
RAG_HISTORY_WINDOW=6
RAG_AUTO_INGEST=true
# 覆盖增量索引清单路径（留空则落在 RAG_PERSIST_DIR 内）
# RAG_MANIFEST_PATH=

# --- 相关性阈值（当前正式启用 0.4）------------------------------------------
# 语义：分数恒为「越大越相关」且落在 [0, 1]（距离由检索层换算，绝不当作相关性），
#       score >= 阈值 才保留（**等于阈值保留**），分数未知（None）时保守放行。
# 位置：判定只在检索层 KnowledgeRetriever._accepts；
#      节点 / RAGService / 评估 / main.py 一律不出现阈值判断。
# 顺序：top_k 先截断、阈值后过滤，且**不补位** —— 过线条数可能少于 top_k。
# 取值：0.4 由 tests/rag/test_score_threshold.py 与真实 A/B 共同标定
#      （真实数据：正样本 0.584–0.768、负样本 0.176–0.35）。
# 生效：阈值是绝对分数，换 Embedding 模型/维度或改切分参数后必须重跑
#      `python main.py --evaluate-rag` 重新标定。
# 关闭：置空或删除本行（不额外过滤），代码里不存在写死的业务阈值。
RAG_SCORE_THRESHOLD=0.4

# -----------------------------------------------------------------------------
# 校园业务服务（Spring Boot + MySQL）
# -----------------------------------------------------------------------------
# 本机 8080 被其它进程占用，故服务跑在 8081；两边必须一致
CAMPUS_SERVICE_BASE_URL=http://localhost:8081
CAMPUS_SERVICE_TIMEOUT=5.0
# 接入统一身份认证前的「当前登录用户」占位
CAMPUS_STUDENT_ID=student-001

# -----------------------------------------------------------------------------
# 校园教务日历（当前学期 / 当前教学周）
# -----------------------------------------------------------------------------
# 全项目**唯一**来源：工具描述与槽位解析（「本学期」→ 具体学期串）都从这里读，
# 任何代码不得再写死第二份（否则换学期要改多处，漏一处就是喂给模型的过期事实）。
# 尚未接入教务校历接口，取值手工维护；学期切换时只改这两行。
CAMPUS_CURRENT_SEMESTER=2026-2027-1
CAMPUS_CURRENT_WEEK=3

# -----------------------------------------------------------------------------
# MCP（可选的调用方式：开启后考试/课程/成绩查询改走 Campus MCP Server）
# -----------------------------------------------------------------------------
CAMPUS_MCP_ENABLED=true
CAMPUS_MCP_SERVER_NAME=campus-mcp-server
# 留空则使用当前解释器
# CAMPUS_MCP_COMMAND=
# 留空则使用默认的 -m app.mcp.server（空格分隔）
# CAMPUS_MCP_ARGS=
# 留空则使用 campus-agent 根目录
# CAMPUS_MCP_CWD=
CAMPUS_MCP_STARTUP_TIMEOUT=30.0
CAMPUS_MCP_CALL_TIMEOUT=20.0

# -----------------------------------------------------------------------------
# LangSmith（可观测性与评估，可选）
# -----------------------------------------------------------------------------
# 只开开关不给 Key 会降级为关闭并告警，不阻断启动
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=<your-langsmith-api-key>
LANGSMITH_PROJECT=lc-course
# 留空则使用官方 SDK 默认地址
# LANGSMITH_ENDPOINT=
